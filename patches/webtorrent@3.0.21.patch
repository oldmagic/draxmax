-      return i => i >= start && i <= end && !(i in tried) && wire.peerPieces.get(i) && (!rank || rank(i))
+    // Pieces worth asking for. Rarest-first rescans every piece per pick, so pieces that
+    // can't be requested (already have / every block already requested) must be excluded
+    // here; otherwise each of them costs a full rescan, which is quadratic in piece count.
+    function requestable (i, hotswap) {
+      const piece = self.pieces[i]
+      if (!piece || self.bitfield.get(i)) return false
+      if (hotswap) return true
+      return piece._reservations < piece._chunks || !!(piece._cancellations && piece._cancellations.length)
+    }
+
+    function genPieceFilterFunc (start, end, tried, rank, hotswap) {
+      return i => i >= start && i <= end && !(i in tried) && wire.peerPieces.get(i) && requestable(i, hotswap) && (!rank || rank(i))
     }
 
     // TODO: Do we need both validateWire and trySelectWire?
