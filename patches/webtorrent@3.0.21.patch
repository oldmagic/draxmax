           const len = end - start + 1
           const tried = {}
           let tries = 0
-          const filter = genPieceFilterFunc(start, end, tried)
+          const filter = genPieceFilterFunc(start, end, tried, null, false)
 
           while (tries < len) {
             piece = self._rarityMap.getRarestPiece(filter)
@@ -1743,7 +1753,7 @@ export default class Torrent extends EventEmitter {
