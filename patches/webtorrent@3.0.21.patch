  * "introduction" (i.e. WebRTC signaling), and there's no equivalent to an IP address
  * that lets you refer to a WebRTC endpoint.
  */
+/**
+ * Per-torrent rate limit, on top of the client-wide one. Incoming peers only learn their
+ * torrent at handshake, so the torrent's group is looked up for every chunk; with no limit
+ * set the chunk passes straight through.
+ */
+function swarmThrottle (peer, dir) {
+  return new Transform({
+    transform (chunk, cb) {
+      const group = peer.swarm?.throttleGroups?.[dir]
+      if (!group || !group.getEnabled()) return cb(null, chunk)
+      throttleChunk(this, peer, group, chunk).then(() => cb(), cb)
+    }
+  })
+}
+
+async function throttleChunk (stream, peer, group, chunk) {
+  let pos = 0
+  while (pos < chunk.length) {
+    if (peer.destroyed) return
+    if (!group.getEnabled()) {
+      stream.push(chunk.subarray(pos))
+      return
+    }
+    const size = Math.min(group.getChunksize(), chunk.length - pos)
+    if (!group.bucket.tryRemoveTokens(size)) {
+      // An error only means the limit changed meanwhile; carry on at the new rate.
+      await new Promise(resolve => group.bucket.removeTokens(size, () => resolve()))
+    }
+    if (peer.destroyed) return
+    stream.push(chunk.subarray(pos, pos + size))
+    pos += size
+  }
+}
+
 Peer.createWebRTCPeer = (conn, swarm, throttleGroups, source = null) => {
   const peer = new Peer(conn.id, 'webrtc', 0)
   peer.conn = conn
