+    )
+      return 'excluded';
+    if (
+      s.mustMatch.length &&
+      !matchesText({ mustContain: s.mustMatch, mustNotContain: [], useRegex: true }, title)
+    )
+      return 'not-matched';
+    return 'ok';
+  }
