diff --git a/apps/web/src/components/RuleFeedsDialog.tsx b/apps/web/src/components/RuleFeedsDialog.tsx
new file mode 100644
index 0000000..50e582a
--- /dev/null
+++ b/apps/web/src/components/RuleFeedsDialog.tsx
@@ -0,0 +1,191 @@
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { AlertTriangle, Loader2 } from 'lucide-react';
+import { useState } from 'react';
+import { toast } from 'sonner';
+import type { RuleDTO } from '@draxmax/shared';
+import { Button } from '@/components/ui/button';
+import { Dialog, DialogContent } from '@/components/ui/dialog';
+import { api } from '@/lib/api';
+
+type Change = 'add' | 'remove';
+
+/**
+ * Adds or removes feeds on several rules at once. Each feed's box shows whether all, none or
+ * some of the selected rules use it; a mixed box is left alone until it is clicked.
+ */
+export function RuleFeedsDialog({
+  rules,
+  open,
+  onClose,
+}: {
+  rules: RuleDTO[];
+  open: boolean;
+  onClose(): void;
+}) {
+  return (
+    <Dialog open={open} onOpenChange={(o) => !o && onClose()}>
+      <DialogContent
+        title={rules.length === 1 ? 'Feeds for 1 rule' : `Feeds for ${rules.length} rules`}
+        description="Tick a feed to add it to every selected rule, untick it to remove it."
+      >
+        {open && <Form key={rules.map((r) => r.id).join()} rules={rules} onClose={onClose} />}
+      </DialogContent>
+    </Dialog>
+  );
+}
+
+function Form({ rules, onClose }: { rules: RuleDTO[]; onClose(): void }) {
+  const qc = useQueryClient();
+  const { data: feeds = [] } = useQuery({ queryKey: ['rss', 'feeds'], queryFn: api.feeds });
+  const [changes, setChanges] = useState<Map<string, Change>>(new Map());
+  const [enable, setEnable] = useState(true);
+  const [applyToExisting, setApplyToExisting] = useState(false);
+
+  const usedBy = (feedId: string) => rules.filter((r) => r.assignedFeedIds.includes(feedId)).length;
+  /** What the box shows: on, off, or mixed (unchanged and only some rules use it). */
+  const shown = (feedId: string): 'on' | 'off' | 'mixed' => {
+    const c = changes.get(feedId);
+    if (c) return c === 'add' ? 'on' : 'off';
+    const n = usedBy(feedId);
+    return n === rules.length ? 'on' : n === 0 ? 'off' : 'mixed';
+  };
+  function cycle(feedId: string) {
+    const n = usedBy(feedId);
+    const initial = n === rules.length ? 'on' : n === 0 ? 'off' : 'mixed';
+    const now = shown(feedId);
+    // mixed → on → off → mixed; plain boxes just toggle.
+    const target =
+      now === 'mixed' ? 'on' : now === 'on' ? 'off' : initial === 'mixed' ? 'mixed' : 'on';
+    const next = new Map(changes);
+    if (target === initial) next.delete(feedId);
+    else next.set(feedId, target === 'on' ? 'add' : 'remove');
+    setChanges(next);
+  }
+
+  const add = [...changes].filter(([, c]) => c === 'add').map(([id]) => id);
+  const remove = [...changes].filter(([, c]) => c === 'remove').map(([id]) => id);
+  const after = (r: RuleDTO) =>
+    [...new Set([...r.assignedFeedIds, ...add])].filter((id) => !remove.includes(id));
+  const allFeedsNow = rules.filter((r) => r.assignedFeedIds.length === 0).length;
+  const becomeAll = rules.filter((r) => r.assignedFeedIds.length > 0 && after(r).length === 0);
+  const disabled = rules.filter((r) => !r.enabled);
+  const wouldEnable = disabled.filter((r) => after(r).length > 0).length;
+
+  const save = useMutation({
+    mutationFn: () =>
+      api.setRuleFeeds({ ids: rules.map((r) => r.id), add, remove, enable, applyToExisting }),
+    onSuccess: (res) => {
+      toast.success(
+        `${res.updated} ${res.updated === 1 ? 'rule' : 'rules'} updated` +
+          (res.enabled ? `, ${res.enabled} turned on` : ''),
+      );
+      void qc.invalidateQueries({ queryKey: ['rss'] });
+      onClose();
+    },
+    onError: (e) => toast.error(e.message),
+  });
+
+  if (feeds.length === 0)
+    return (
+      <p className="py-6 text-center text-sm text-muted">
+        No feeds yet. Add one on the Feeds tab first.
+      </p>
+    );
+
+  return (
+    <form
+      className="space-y-4"
+      onSubmit={(e) => {
+        e.preventDefault();
+        save.mutate();
+      }}
+    >
+      <ul className="max-h-72 space-y-0.5 overflow-y-auto rounded-xl bg-surface-2 p-1.5">
+        {feeds.map((f) => {
+          const state = shown(f.id);
+          const n = usedBy(f.id);
+          return (
+            <li key={f.id}>
+              <label className="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 hover:bg-surface-hover">
+                <input
+                  type="checkbox"
+                  checked={state === 'on'}
+                  ref={(el) => {
+                    if (el) el.indeterminate = state === 'mixed';
+                  }}
+                  onChange={() => cycle(f.id)}
+                  className="size-4 shrink-0 accent-[var(--accent)]"
+                />
+                <span className="min-w-0 flex-1">
+                  <span className="block truncate text-sm" title={f.url}>
+                    {f.title}
+                  </span>
+                  <span className="block text-xs text-muted">
+                    {changes.get(f.id) === 'add'
+                      ? `Will be added to ${rules.length - n} ${rules.length - n === 1 ? 'rule' : 'rules'}`
+                      : changes.get(f.id) === 'remove'
+                        ? `Will be removed from ${n} ${n === 1 ? 'rule' : 'rules'}`
+                        : `Used by ${n} of ${rules.length}`}
+                  </span>
+                </span>
+              </label>
+            </li>
+          );
+        })}
+      </ul>
+
+      {allFeedsNow > 0 && add.length > 0 && (
+        <p className="flex gap-2 text-xs text-muted">
+          <AlertTriangle className="size-4 shrink-0 text-warning" />
+          {allFeedsNow} selected {allFeedsNow === 1 ? 'rule applies' : 'rules apply'} to every feed
+          now; after this {allFeedsNow === 1 ? 'it' : 'they'} only use the ticked feeds.
+        </p>
+      )}
+      {becomeAll.length > 0 && (
+        <p className="flex gap-2 text-xs text-muted">
+          <AlertTriangle className="size-4 shrink-0 text-warning" />
+          {becomeAll.length} {becomeAll.length === 1 ? 'rule is' : 'rules are'} left without feeds
+          and will apply to every feed.
+        </p>
+      )}
+
+      <div className="space-y-2 text-sm">
+        {disabled.length > 0 && (
+          <label className="flex items-center gap-2">
+            <input
+              type="checkbox"
+              checked={enable}
+              onChange={(e) => setEnable(e.target.checked)}
+              className="size-4 accent-[var(--accent)]"
+            />
+            Turn on disabled rules that get a feed
+            {enable && wouldEnable > 0 && <span className="text-muted">({wouldEnable})</span>}
+          </label>
+        )}
+        <label className="flex items-center gap-2">
+          <input
+            type="checkbox"
+            checked={applyToExisting}
+            onChange={(e) => setApplyToExisting(e.target.checked)}
+            className="size-4 accent-[var(--accent)]"
+          />
+          Also download matching articles already in these feeds
+        </label>
+      </div>
+
+      <div className="flex justify-end gap-2">
+        <Button variant="ghost" onClick={onClose}>
+          Cancel
+        </Button>
+        <Button
+          type="submit"
+          variant="primary"
+          disabled={save.isPending || (changes.size === 0 && !(enable && wouldEnable > 0))}
+        >
+          {save.isPending && <Loader2 className="animate-spin" />}
+          Apply
+        </Button>
+      </div>
+    </form>
+  );
+}
