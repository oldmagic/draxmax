+      result('[SubsPlease] Sousou no Frieren S2 - 01-04 (720p) [Batch]', 30, 1),
+      result('[SubsPlease] Sousou no Frieren S2 - 03 (720p)', 10, 3),
+      result('[SubsPlease] Sousou no Frieren S2 - 04 (720p)', 10, 4),
