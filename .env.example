# Copy to .env and adjust. Every value is optional.
TZ=Europe/Paris
PUID=1000
PGID=1000
PORT=8895
TORRENT_PORT=6881
# Web UI listen address. Set to your LAN address to keep it off other interfaces.
# HOST=192.168.1.10
# Default save folder inside the container (must be a mounted volume)
# DOWNLOAD_PATH=/media

# Web UI login (recommended when reachable from other devices)
# WEBUI_USERNAME=admin
# WEBUI_PASSWORD=change-me

# Upcoming: free TMDB key for movies & TV (anime via AniList needs no key)
# TMDB_API_KEY=

# Token for scripts/automation: Authorization: Bearer <token>
# API_TOKEN=

# DOWNLOAD_LIMIT=-1          # bytes/s, -1 = unlimited
# UPLOAD_LIMIT=-1
# MAX_ACTIVE_DOWNLOADS=5     # 0 = unlimited
# ENABLE_DHT=true
# ENABLE_PEX=true
# ENABLE_LSD=true
# ENABLE_UPNP=true
# ENCRYPTION=1               # 0 off, 1 prefer, 2 require
# DEFAULT_TRACKERS=udp://tracker.opentrackr.org:1337/announce,udp://open.stealth.si:80/announce
# ADD_DEFAULT_TRACKERS=false
# RSS_REFRESH_MINUTES=30
# Missing episodes: search for released episodes your RSS rule folders lack
# MISSING_ENABLED=true
# MISSING_INTERVAL_HOURS=6
# TORZNAB_URLS=http://prowlarr:9696/1/api?apikey=xxxx http://prowlarr:9696/2/api?apikey=xxxx
# LIBRARY_FOLDERS=/data/library/tv,/data/library/movies
# SEARCH_URL_TEMPLATE=https://example.org/search?q={query}
# Unfinished downloads live here and move to their save folder when done
# INCOMPLETE_PATH=/media/incomplete
# MIN_FREE_SPACE_MB=512      # stop downloading below this much free space, 0 = never
# SEED_TIME_LIMIT_MINUTES=0  # 0 = no limit
# SEED_LIMIT_ACTION=remove   # or pause (keep it in the list; use this with Sonarr/Radarr)
# MISSING_WHEN_EMPTY=wait    # or download (fetch a season from episode 1 for empty rule folders)
# Phone/chat notifications: ntfy topic, Discord webhook, Telegram bot URL, or any JSON webhook
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-topic
# LOG_LEVEL=info
