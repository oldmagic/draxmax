# Development image: source is bind-mounted, the server and Vite run with hot reload.
FROM node:25-bookworm
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN corepack enable
WORKDIR /src
EXPOSE 8895 5173
CMD ["sh", "-c", "pnpm install --frozen-lockfile --filter '@draxmax/server...' --filter '@draxmax/web...' && pnpm dev"]
