{
  "name": "@draxmax/desktop",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "description": "DraxMax desktop app",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "stage": "node package.mjs",
    "dist": "node package.mjs && electron-builder --config electron-builder.yml --publish never",
    "dist:dir": "node package.mjs && electron-builder --config electron-builder.yml --dir --publish never"
  },
  "dependencies": {
    "@draxmax/core": "workspace:*",
    "@draxmax/server": "workspace:*",
    "@draxmax/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "fastify": "^5.12.8",
    "magnet-uri": "^7.0.10",
    "parse-torrent": "^11.0.24",
    "rss-parser": "^3.13.0",
    "webtorrent": "^3.0.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "author": "DraxMax",
  "license": "MIT"
}
